# Use Neon's direct (unpooled) endpoint when DATABASE_SCHEMA is set.
DATABASE_URL=
# Required when sharing Scanora's database; leave blank only for a separate database.
DATABASE_SCHEMA=scanora_invites
APP_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Alternatively set ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional dedicated test database, never your original Scanora database.
TEST_DATABASE_URL=
