{
  "name": "scanora-celebrates",
  "version": "1.0.0",
  "private": true,
  "description": "Admin-managed printed QR wedding invitations",
  "engines": { "node": ">=22.17" },
  "scripts": {
    "start": "node server/index.cjs",
    "dev": "node --watch server/index.cjs",
